# Copy this file to .env.local and fill in real values.
# Add the same variables in Cloudflare Pages > Settings > Environment variables
# when deploying (Phase 7 of docs/MASTER_GUIDE.md).

# --- Supabase (Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Cloudflare R2 (file storage + backups) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_PRODUCTS=zeroplus-products
R2_BUCKET_BACKUPS=zeroplus-db-backups

# --- SlipOK (docs/SLIPOK_SETUP.md) ---
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=

# --- Discord notifications (docs/DISCORD_SETUP.md) ---
DISCORD_WEBHOOK_URL=

# --- Backup monitoring (docs/BACKUP_SETUP.md) ---
HEALTHCHECK_PING_URL=
